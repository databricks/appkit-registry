{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "appkit",
  "homepage": "https://github.com/databricks/appkit-registry",
  "items": [
    {
      "name": "metric-card",
      "type": "registry:block",
      "title": "Metric Card",
      "description": "A KPI card with a value, a period-over-period delta badge, and an optional icon. Built on AppKit UI Card + Badge.",
      "author": "Databricks AppKit",
      "meta": { "verified": true },
      "categories": ["dashboard", "kpi", "metrics", "card", "chart", "stats"],
      "dependencies": ["@databricks/appkit-ui@^0.41.0", "lucide-react@^0.554.0"],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/metric-card/metric-card.tsx",
          "type": "registry:component",
          "target": "components/appkit/metric-card.tsx"
        }
      ]
    },
    {
      "name": "hello",
      "type": "registry:file",
      "title": "Hello Plugin",
      "description": "Minimal example AppKit server plugin that exposes a GET /api/hello route. Added with `appkit add hello`.",
      "author": "Databricks AppKit",
      "categories": ["example", "server", "plugin", "starter", "route"],
      "dependencies": ["@databricks/appkit@^0.41.0"],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/hello/manifest.json",
          "type": "registry:file",
          "target": "plugins/hello/manifest.json"
        },
        {
          "path": "registry/hello/hello.ts",
          "type": "registry:file",
          "target": "plugins/hello/hello.ts"
        },
        {
          "path": "registry/hello/index.ts",
          "type": "registry:file",
          "target": "plugins/hello/index.ts"
        }
      ]
    }
  ]
}
